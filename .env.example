# ── Postgres ──────────────────────────────
POSTGRES_USER=perekup
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=perekup
DATABASE_URL=postgresql+psycopg2://perekup:change_me_strong_password@db:5432/perekup
# Для локальной разработки без Docker:
# DATABASE_URL=sqlite:///./dev.db

# ── Backend ─────────────────────────────────
SECRET_KEY=change_me_super_secret_key_32_chars_min
TELEGRAM_BOT_TOKEN=123456789:AA_xxx_your_bot_token_here
TELEGRAM_DEV_MODE=true
# В dev-режиме фронт может логиниться без Telegram (initData="dev")
# В production обязательно false
CORS_ORIGINS=https://your-domain.com,https://localhost
API_HOST=0.0.0.0
API_PORT=8000

# ── Frontend (Vite) ─────────────────────────
# Для docker-compose (nginx проксирует /api -> backend):
VITE_API_URL=/api
# Для локальной разработки (vite dev + uvicorn):
# VITE_API_URL=http://localhost:8000/api

# ── Опционально: LLM для текстов (если пусто — шаблоны) ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Game ────────────────────────────────────
START_BALANCE=5000
SEASON_GOAL=50000
